#!/bin/sh
# =============================================================================
# 99-h29k-growroot - 首次启动把 rootfs 分区撑满 eMMC 剩余空间
#
# 为什么要这个：镜像里 rootfs 固定 2 GiB（CONFIG_TARGET_ROOTFS_PARTSIZE），
# 但 eMMC 通常是 8/16/32/64 GB。上个项目（v3）就是因为分区写死，
# /overlay 只剩 338 MB，装 Docker 镜像立刻爆盘，只能再补一个 p3 data 分区。
# 这里改成：开机自动把 p2（rootfs）扩到磁盘末尾，一步到位，不用手工分区。
#
# 只扩不缩；任何一步失败都安静退出（不影响启动），下次开机重试。
# =============================================================================

DEV=/dev/mmcblk0
PART=2

[ -b "$DEV" ] || exit 0
command -v parted >/dev/null 2>&1 || exit 0
command -v resize2fs >/dev/null 2>&1 || exit 0

# 已经是 100% 就没事可做
cur_end=$(parted -s "$DEV" unit s print 2>/dev/null | awk -v p="$PART" '$1 == p { sub(/s$/, "", $3); print $3 }')
disk_end=$(parted -s "$DEV" unit s print 2>/dev/null | awk '/^Disk \/dev/ { sub(/s$/, "", $3); print $3 }')
[ -n "$cur_end" ] && [ -n "$disk_end" ] || exit 0
[ "$cur_end" -lt "$disk_end" ] || exit 0

logger -t h29k-growroot "rootfs 结束于 ${cur_end}s，磁盘 ${disk_end}s，开始扩容"

if parted -s "$DEV" unit s resizepart "$PART" 100% >>/var/log/h29k-growroot.log 2>&1; then
	blockdev --rereadpt "$DEV" 2>/dev/null
	sleep 1
	if resize2fs "${DEV}p${PART}" >>/var/log/h29k-growroot.log 2>&1; then
		logger -t h29k-growroot "扩容完成：$(df -h / | awk 'NR==2 {print $2}')"
	else
		logger -t h29k-growroot "resize2fs 失败，详见 /var/log/h29k-growroot.log"
	fi
else
	logger -t h29k-growroot "parted 扩容失败，详见 /var/log/h29k-growroot.log"
fi

exit 0

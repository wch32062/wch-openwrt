# ==========================================================================
# H29K —— ImmortalWrt 源码构建的种子配置（配套 .github/workflows/H29K-imwrt.yml）
#
# 和 configs/h29k.config（lede 版）的区别：
#   * 走 ImmortalWrt，qmodem 能选中（lede 缺 kmod-mhi-wwan / quectel-CM-5G）
#   * 板级支持来自 ouyangzq/H29KorH69K-OPENWRT 的 BSP，不是 lede 自带的 hinlink_opc-h29k
#   * rootfs 用 squashfs，分区大小由工作流输入覆盖（默认 2048 MiB）
# ==========================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_opc-h29k=y
CONFIG_TARGET_PROFILE="DEVICE_hinlink_opc-h29k"

CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# LuCI + 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y

# 5G：qmodem（拨号/模组管理）+ Quectel 驱动
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# 常用
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y

# С����1.47 �� ST7789V��SPI1������ dtb ʵ�⣩
CONFIG_PACKAGE_kmod-fb-tft=y
CONFIG_PACKAGE_kmod-fb-tft-st7789v=y

# ==========================================================================
# H29K 鈥斺€?ImmortalWrt 婧愮爜鏋勫缓鐨勭瀛愰厤缃紙閰嶅 .github/workflows/H29K-imwrt.yml锛?#
# 鍜?configs/h29k.config锛坙ede 鐗堬級鐨勫尯鍒細
#   * 璧?ImmortalWrt锛宷modem 鑳介€変腑锛坙ede 缂?kmod-mhi-wwan / quectel-CM-5G锛?#   * 鏉跨骇鏀寔鏉ヨ嚜 ouyangzq/H29KorH69K-OPENWRT 鐨?BSP锛屼笉鏄?lede 鑷甫鐨?hinlink_opc-h29k
#   * rootfs 鐢?squashfs锛屽垎鍖哄ぇ灏忕敱宸ヤ綔娴佽緭鍏ヨ鐩栵紙榛樿 2048 MiB锛?# ==========================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_opc-h29k=y
CONFIG_TARGET_PROFILE="DEVICE_hinlink_opc-h29k"

CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048

# LuCI + 涓枃
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_LUCI_LANG_zh_Hans=y

# 5G锛歲modem锛堟嫧鍙?妯＄粍绠＄悊锛? Quectel 椹卞姩
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-wdm=y

# 甯哥敤
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y

CONFIG_PACKAGE_video-support=y
# 小屏：1.14 寸 ST7789V（SPI1，按 1.3 固件 dtb）
CONFIG_PACKAGE_kmod-fb-tft=y
CONFIG_PACKAGE_kmod-fb-tft-st7789v=y

# 编译器缓存：本机重编从 2 小时降到几分钟；CI 里配合 actions/cache 也有效
CONFIG_DEVEL=y
CONFIG_CCACHE=y

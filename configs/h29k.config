# ==========================================================================
# H29K —— HINLINK OPC-H29K（Rockchip RK3528，eMMC）
#
# 这是“种子配置”：工作流会执行 `make defconfig` 把它补全成完整 .config。
#
# 设备自带的软件包由 lede 的目标定义提供，这里不要重复写：
#     kmod-aic8800-sdio     AIC8800 SDIO 无线驱动（含固件）
#     kmod-fb-tft-st7789v   ST7789V 屏幕驱动
#     wpad-openssl          hostapd / wpa_supplicant（lede 设备定义选的是 openssl 版）
#     -urngd                该设备不需要 urngd
#
# 注意：wpad-basic-mbedtls 与 wpad-openssl 同样 PROVIDE wpad，
#       同时出现在镜像里会导致打包冲突，因此不要在这里指定 wpad。
#
# 固件容量：CONFIG_TARGET_ROOTFS_PARTSIZE 是 rootfs 分区大小（MiB）。
# 取 4096 与已验证的 v5/v6 一致：镜像文件本身不大（gz 约 30 MB），
# 首次开机 fstools 会在 p2 剩余空间上自动建 overlay，可用约 3.9 GiB。
# eMMC 只有 8 GB 的机器也用 4096，别超过实际容量。
# ==========================================================================

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_hinlink_opc-h29k=y
CONFIG_TARGET_PROFILE="DEVICE_hinlink_opc-h29k"

# squashfs + overlay：与原厂镜像同构，支持 failsafe/回滚
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=4096

# LuCI + 中文 + 常用工具
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y

# ---- 5G 模块（M.2/USB，QMI / MBIM / AT 串口）----
# 这些驱动不在 H29K 的 DEVICE_PACKAGES 里，必须显式选中，否则插卡不认设备。
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_luci-proto-mbim=y

# Quectel 专用驱动：RM500U / RM520N 这类模组走 QMAP 时，内核自带的 qmi_wwan 不认，
# 必须要 qmodem feed 里的 qmi_wwan_q；PCIe 形态的模组（MHI）还要 pcie_mhi。
CONFIG_PACKAGE_kmod-qmi-wwan-q=y
CONFIG_PACKAGE_kmod-pcie-mhi=y

# ---- QModem：模组管理 + 拨号（v3 里用的就是它）----
# 对应 diy-part1.sh 里追加的 qmodem feed（FUjr/QModem）。
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_luci-app-qmodem-uplink=y

# 首次开机扩容用
CONFIG_PACKAGE_parted=y
